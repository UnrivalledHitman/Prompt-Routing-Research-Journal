\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Escalation policies on the public pool under oracle detection, in US dollars per 1{,}000 queries. P1 climbs the cost--accuracy frontier, P3 uses its top rung once, P4 starts uniformly over the pool and then climbs, and Random picks a model uniformly and recovers at the top rung. A policy that answers fewer queries can show a negative tax, underpaying by failing, so the tax is read beside the solved column.}}{18}{}\protected@file@percent }
\newlabel{tab:public}{{12}{18}{}{table.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Escalation policies on the hosted ladder under oracle detection, in US dollars per 1{,}000 queries. The static rows are the ladder rungs used alone. As on the public pool, a policy that answers fewer queries can show a negative tax by underpaying through failure, so the tax is read beside the solved column.}}{18}{}\protected@file@percent }
\newlabel{tab:hosted}{{13}{18}{}{table.13}{}}
