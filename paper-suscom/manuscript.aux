\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}The escalation tax on the local grid}{13}{}\protected@file@percent }
\newlabel{sec:results-tax}{{6.2}{13}{}{subsection.6.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces The escalation tax per prompt, in joules, split into escalation and stickiness, under oracle detection (solid) and imperfect detection (hatched). Error bars are 95\% bootstrap intervals on the total. P4 starts uniformly over the cells.}}{13}{}\protected@file@percent }
\newlabel{fig:tax}{{3}{13}{}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Escalation policies on the local grid over the 1{,}200 gradable prompts, in joules. Cost per solved divides a policy's mean energy per prompt by its solved rate, as in \eqref  {eq:persolved}. The tax and its two components are means over servable prompts, and the last column divides the tax by the mean cost of $c^{*}(q)$, 190.6\,J. Imperfect detection is the illustrative point $p_{\mathrm  {acc}} = 0.15$, $p_{\mathrm  {rej}} = 0.05$.}}{14}{}\protected@file@percent }
\newlabel{tab:tax}{{9}{14}{}{table.9}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Routing on the local grid}{14}{}\protected@file@percent }
\newlabel{sec:results-routing}{{6.3}{14}{}{subsection.6.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces Routers on the 243 test prompts, in joules, with a failed routed answer recovered at $c_8$ and every failure detected. Net cost is the mean energy per prompt with the router's own energy included; its interval is for the first training seed, and the standard deviation across three seeds follows in parentheses. Saving and the change in solved rate are paired differences against P1, positive when the router is cheaper or solves more, with Holm-corrected $p$-values. Area is the normalised area under the router's cost--quality frontier as $\tau $ varies. For the cascade, $\tau $ is its verification threshold.}}{15}{}\protected@file@percent }
\newlabel{tab:routers}{{10}{15}{}{table.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Router overhead per decision, averaged over seeds and both training objectives. CPU energy is an upper bound, decision time multiplied by 54\,W; GPU energy is metered. The LoRA router is charged the zero-shot probe's cost. Cascade figures are per verification check, and a query may need several.}}{15}{}\protected@file@percent }
\newlabel{tab:overhead}{{11}{15}{}{table.11}{}}
